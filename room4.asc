// room script file

function hLockerDoor_Interact()
{
cJack.Say("It's locked.");
}

function hLockerDoor_Look()
{
cJack.Say("What? Do you expect me to say a locker's door ?....");
cJack.Say("Well I already did it...");
}

function hLockerDoor_UseInv()
{
if (cJack.ActiveInventory == iKey){
  cJack.Say("It doesen't fit.");
}

}

function oLockerDoor_Interact()
{
cJack.Say("It's locked.");
}

function oLockerDoor_Look()
{
cJack.Say("What? Do you expect me to say a locker's door ?....");
cJack.Say("Well I already did it...");
}

function oLockerDoor_Talk()
{
cJack.Say("NO");
}

function oLockerDoor_UseInv()
{
if (cJack.ActiveInventory == iKey) {
  cJack.Say("It worked.");
  oLockerDoor.Visible = false;
  oOpenedLockerDoor.Visible = true;
}
}



function hItemSpot_AnyClick()
{
  cJack.Walk(214, 139);
  cJack.Say("Huh. Let's see...");
  cJack.AddInventory(iRuneBoard);
  Display("The Rune Board has been added to your inventory.");
  cJack.Say("Some kind of stone with some runes written on it... I don't know how to read this !");
  
}



function hTools_Look()
{
cJack.Say("A bunch of tools.");
}

function hTools_Talk()
{
  cJack.Say("NO");
}


function hTools_Interact()
{
cJack.Walk(244, 139, eBlock, eWalkableAreas); 
cJack.Say("I think I'll grab this.");
cJack.AddInventory(iSpear);
Display("A spear has been added to your inventory");
}

function room_LeaveLeft()
{
cJack.ChangeRoom(3, 287, 180);
}
