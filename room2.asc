// room script file

function room_FirstLoad()
{
  cJack.Say("Here we go again");
  
}

function hHotspot4_Look()
{
cJack.Say("An old rusty pipe.");
}
function hPipe_Interact()
{
cJack.Say("There's something sticking out of the pipe");
cJack.Walk(218, 148, eBlock, eWalkableAreas);
Display("You find a strange object stuck inside the pipe and start pulling it out");
Disket.Visible=true;
}
function Disket_Look()
{
cJack.Say("I have no clue what this is supossed to be");
}

function Disket_Interact()
{
  cJack.Walk(218, 148, eBlock, eWalkableAreas);
  cJack.Say("Ok ok I'll pick it up...");
  Disket.Visible=false;
  cJack.AddInventory(iDisket);
}



function hHotspot2_Look()
{
cJack.Say("Smells like something's rotten in here (:");
}
function hHotspot2_Interact()
{
cJack.Walk(116, 63, eBlock, eWalkableAreas);
cJack.Say("Let's see what we've got here");
Display("At the bottom of the bin you find your old crowbar");
Crowbar.Visible=true;
cJack.Say("This might come in handy");

}
function iCrowbar_Look()
{
cJack.Say("My old crowbar");
}
function oCrowbar_Interact()
{
cJack.Walk(116, 63, eBlock, eWalkableAreas);  
Crowbar.Visible=false;
cJack.AddInventory(iCrowbar);
}



function hHotspot3_Look()
{
cJack.Say("What a nice bike!");
}

function hHotspot3_Interact()
{
  cJack.Walk(198, 46, eBlock, eWalkableAreas);
cJack.Say("Get yourself togheter Jack there's no time for stealing now...");
}






function hUndergroundTunnels_Interact()
{
cJack.Walk(109, 146, eBlock, eWalkableAreas);
cJack.ChangeRoom(3, 102, 86);
}

function BasementDoor_UseInv()
{
  if (cJack.ActiveInventory == iCrowbar){
    cJack.Walk(111, 146, eBlock, eWalkableAreas);
    cJack.Say("That should do it.");
    BasementDoor.Visible=false;
  }

}

function BasementDoor_Interact()
{
cJack.Walk(116, 146, eBlock, eWalkableAreas);
cJack.Say("Looks like it's jammed. I need to find something to pry it open.");
}

function BasementDoor_Talk()
{
cJack.Say("HELLO DOOR !");
}
