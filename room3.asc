// room script file

function room_FirstLoad()
{
aMusic2.Play(2);
cJack.Walk(45, 168, eBlock, eWalkableAreas);
cBart.Say("!!!!!!!!!");
cJack.FaceLocation(cJack.x+1, cJack.y);
cJack.Say("?");
cBart.Walk(93, 168, eBlock, eWalkableAreas);
cBart.LockView(VBARTANGRY);
cBart.Animate(0, 5, eOnce, eBlock);
cJack.Say("Woah, what the hell Bart ?! You dumb pile of bones, It's me !!");
cBart.LockView(VBARTSORRY);
cBart.Animate(0, 5, eOnce, eBlock);
cBart.Say(".... I'm sorry Jack.. I didn't realise I'm too stressed out today !");
cBart.LockView(VBARDIDLE);


}
function hPoster_Look()
{
Display("WANTED: Jack the Ripper");
}

function hPoster_PickUp()
{
cJack.Say("I have no use for that.");
}

function VaultDoor_Look()
{
cJack.Say("The Vault Door. No one has managed to open this in ages.");
}

function VaultDoor_Talk()
{
cJack.Say("OPEN SESAME !");
cJack.Say("It was worth a try");
}



function room_LeaveRight()
{
cJack.ChangeRoom(4, 2, 157);
}



function hSpiderWeb_Interact()
{
cJack.Say("I can't reach that high");
}
function hSpiderWeb_Look()
{
cJack.Say("There's something stuck in that spider web");
}

function hSpiderWeb_UseInv()
{
if (cJack.ActiveInventory == iSpear){
  cJack.Say("I should be able to get that down if i hit it with the spear. I hope i don't miss. Here we go !");
  oRuneCypher.Visible = true;
  cBart.Say("Nice skill.");
  cJack.Say("A Rune Cypher ? I thought those things we're a myth.");
}
  
}



function hDirtyWater_Look()
{
cJack.Say("I wonder what's at the bottom of this");
}

function hBone_Look()
{
cJack.Say("Bart you're missing some parts i think.");
cBart.Say("I'll pick them up later.");
}
function hBone_Interact()
{
cJack.Say("I'm not touching that");
}

function hHotspot6_Interact()
{
cJack.Walk(97, 87, eBlock, eWalkableAreas);
cJack.ChangeRoom(2, 124, 141);
}

function oRuneCypher_Look()
{
cJack.Say("A Rune Cypher.");
}

function oRuneCypher_Interact()
{
cJack.Walk(239, 184, eBlock, eWalkableAreas);
cJack.Say("Yoink!");
oRuneCypher.Visible = false;
Display("The Rune Cypher has been added to your inventory");
cJack.AddInventory(iRuneCypher);
}



function VaultDoor_UseInv()
{
if (cJack.ActiveInventory == iNote){
  cJack.Walk(178, 167, eBlock, eWalkableAreas);
  cBart.FaceCharacter(cJack);
  cJack.Say("So. 1 up 2 down 7 top right 22 top left 3 down 3 down left 15 down right.");
  cJack.Say("......");
  cBart.Say("......");
  oVaultDoor.Visible = false;
  cBart.Say("What the ****");
  Display("What the ****");
  cJack.Say("Indeed");
}
}

function hOffice_Interact()
{
cJack.Walk(181, 169, eBlock, eWalkableAreas);
cJack.Say("Ready or not, here I come !");
cBart.Say("Go get her tiger");
cJack.Say("No words.");
cBart.Say("I'm sorry.");
cJack.ChangeRoom(5, 254, 183);
}
