// room script file
Overlay *textOverlay;
function ShowTextCentered(String text)
{
  int centerX, centerY;
  int textWidth, textHeight; 
  int x, y;
  centerX = System.ViewportWidth / 2;
  centerY = System.ViewportHeight / 2;
  textWidth = GetTextWidth(text, eFontNormal);
  textHeight = GetTextHeight(text, eFontNormal, textWidth + 7);
  x = centerX - (textWidth / 2);
  y = centerY - (textHeight / 2);
  textOverlay = Overlay.CreateTextual(x, y, textWidth + 7, eFontNormal, 27777, text);
  
}
function room_AfterFadeIn()
{
  ShowTextCentered("Present Day.");
cJack.Walk(111, 174, eBlock, eWalkableAreas);
cJack.LockView(VJACKGUNOUT);
cJack.Animate(2, 3, eOnce, eBlock);
cJack.LockView(VJACKSHOOT);
cJack.Animate(2, 4, eOnce, eBlock);
cJack.Animate(2, 4, eOnce, eBlock);
cJack.Animate(2, 4, eOnce, eBlock);
cJack.LockView(VJACKRELOAD);
cJack.Animate(2, 4, eOnce, eBlock);
cJack.LockView(VJACKCROUCHSHOOT);
cJack.Animate(2, 4, eOnce, eBlock);
cJack.Animate(2, 4, eOnce, eBlock);
cJack.Animate(2, 4, eOnce, eBlock);
cJack.Animate(2, 4, eOnce, eBlock);
cJack.LockView(VIEW1);
cJack.Walk(317, 169, eBlock, eWalkableAreas);
ShowTextCentered("Thank you for playing !!! I hope you enjoyed !!!");
}
