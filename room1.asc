function room_FirstLoad()
{
  
}
function room_AfterFadeIn()
{
  aMusic1.Play(1);
  StartCutscene(eSkipESCOnly);
  
  cJack.Say("Guess i have to clean up this mess now goddamit. She put up a fight unlike the others after all...");
  Display("*Footsteps sound*");
  Display("What will you do Jack ?");
  
  cJack.Walk(258, 77, eBlock, eWalkableAreas);
  cJack.Say("Tsss. Im getting too old for this.");
  cGirl.Walk(150, 124, eBlock, eWalkableAreas);
  cGirl.Say("!!!!");
  cGirl.Walk(106, 147, eBlock, eWalkableAreas);
  cGirl.Say("What happened here ?...");
  cGirl.Walk(61, 161, eBlock, eWalkableAreas);
  BasementDoor.Visible=true;
  cGirl.ChangeRoom(5, 0, 0);
  Display("DO SOMETHING JACK OR SHE WILL FIND OUT");
  cJack.ChangeRoom(2, 252, 87);
  
  
  
  
  EndCutscene();
  
}
