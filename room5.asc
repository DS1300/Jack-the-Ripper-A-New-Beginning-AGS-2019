// room script file

function room_AfterFadeIn()
{
  aMusic3.Play(3);
  Display("Jack's life was about to change.Little did he know that what had to come was bigger than everything he ever knew.");
  Display("Literally");
cJack.Walk(166, 186, eBlock, eWalkableAreas);
cJack.Say("Woah... What is this ? Where is she ?");
cJack.FaceLocation(cJack.x+1, cJack.y);
  Wait(40);
cJack.FaceLocation(cJack.x-1, cJack.y);
cJack.Say("Why is everything so big ?");
Display("Told you.");
}



